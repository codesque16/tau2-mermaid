# =============================================================
# models/gemma4-26b-a4b-bf16.env
# Gemma 4 26B A4B — MoE, 3.8B active / 26B total params
#
# Architecture : Mixture-of-Experts (128 experts, top-8 routing)
# Context      : 256K tokens
# Audio input  : NO (server models only)
# VRAM weights : ~52GB BF16 — fits RTX Pro 6000 (96GB)
# Active params: 3.8B per token → inference speed like a 4B model
# Quality      : 1441 Arena Elo — nearly matches 31B Dense (1452)
# GA status    : RTX Pro 6000 on Cloud Run is Preview
# =============================================================

export PROJECT_ID="gemini-1xn"
export REGION="us-central1"

# Correct HF ID — google/gemma-4-26B-A4B-it (not 27b)
export HF_MODEL_ID="google/gemma-4-26B-A4B-it"
export HF_TOKEN=""
export SERVED_MODEL_NAME="gemma4-26b"

export GPU_TYPE="nvidia-rtx-pro-6000"  # 96GB — BF16 52GB + KV cache headroom
export CPU_COUNT="20"
export MEMORY_GB="80"

# BF16 — full quality, 52GB weights leaves ~40GB for KV cache
# 32K context is very comfortable in BF16 on 96GB
export QUANTIZATION="bf16"
export MAX_MODEL_LEN="32767"
export MAX_NUM_SEQS="16"             # MoE is fast — can run more concurrently
export GPU_MEM_UTIL="0.95"
export TENSOR_PARALLEL_SIZE="1"
export LOAD_FORMAT="runai_streamer"
export EXTRA_VLLM_FLAGS="--enable-chunked-prefill --enable-prefix-caching --generation-config auto"
export TOOL_CALL_PARSER="gemma4"
export REASONING_PARSER="gemma4"

export SERVICE_NAME="gemma4-26b-bf16"
export MAX_INSTANCES="1"
export CONCURRENCY="32"

export MODEL_BUCKET="gemini-1xn-us-central1-hf-model-cache"
export GCS_MODEL_PATH="gs://${MODEL_BUCKET}/model-cache/${HF_MODEL_ID}"
export VPC_NETWORK="vllm-cr-net"
export VPC_SUBNET="vllm-cr-subnet"
export SUBNET_RANGE="10.8.0.0/26"
export SA_NAME="vllm-cr-sa"
export SA_EMAIL="${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export VLLM_IMAGE="us-docker.pkg.dev/vertex-ai/vertex-vision-model-garden-dockers/pytorch-vllm-serve:gemma4"
