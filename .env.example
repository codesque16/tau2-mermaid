# API keys (set the ones you need for the model in configs/simulation.yaml)
# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# or
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional split keys (assistant simulator vs GEPA optimizer/reflection/diagnosis).
# If set, *_ASSISTANT is used by runtime agents and *_GEPA by GEPA components.
OPENAI_API_KEY_ASSISTANT=
OPENAI_API_KEY_GEPA=
GOOGLE_API_KEY_ASSISTANT=
GEMINI_API_KEY_ASSISTANT=
GOOGLE_API_KEY_GEPA=
GEMINI_API_KEY_GEPA=
ANTHROPIC_API_KEY_ASSISTANT=
ANTHROPIC_API_KEY_GEPA=

# Logfire (optional): https://logfire.pydantic.dev/ — for tracing and observability
LOGFIRE_TOKEN="pylf_v1_us_pkhMwRCBm4sWrKtSrn45W7rdc0GVfZPJPKXQv1VP7LTK"
LOGFIRE_SERVICE_NAME=tau2-mermaid
# Gemini in Logfire: capture prompts/completions (optional, default true in app)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Google Cloud Trace Explorer: same Logfire spans, also exported to GCP (on by default).
# Disable with: TAU2_GCP_TRACE=0
# ADC: gcloud auth application-default login — set project to match Trace Explorer:
# GOOGLE_CLOUD_PROJECT=gemini-txn
# LOGFIRE_SERVICE_NAME=tau2-mermaid   # filter by this "Service" in Trace Explorer (default)
# TAU2_GCP_TRACE_DEBUG=1              # stderr: resolved project + exporter logs
# If you see "Reauthentication is needed" / Error while writing to Cloud Trace: ADC expired.
#   gcloud auth application-default login
# Until fixed, silence Cloud Trace: TAU2_GCP_TRACE=0
# Cloud Trace limits labels (32) and annotation attrs (4/event) — see TAU2_GCP_TRACE_SLIM_GENAI in logfire_gemini_integration.
# TAU2_GCP_TRACE_BSP_DELAY_MS=1000
# TAU2_GCP_TRACE_PERIODIC_FLUSH_SEC=5
# TAU2_GCP_TRACE_IMMEDIATE=1          # default on: export each ended span immediately
# TAU2_GCP_TRACE_SLIM_GENAI=1   # default: omit OpenInference llm.* flattening so gen_ai.* fits GCP (set 0 for full OI attrs)
